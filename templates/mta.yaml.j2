_schema-version: "3.1"
ID: {{ artifact_id }}
description: "{{ artifact_id }} — migrated from SAP NetWeaver to Spring Boot on BTP CF"
version: 1.0.0

# ── Modules ────────────────────────────────────────────────────────────────────

modules:
{% if has_db_module %}
  # 1. HDI deployer — creates HANA Cloud schema objects before the app starts
  - name: {{ artifact_id }}-db
    type: hdb
    path: db
    requires:
      - name: {{ hdi_service_name }}
    build-parameters:
      ignore:
        - node_modules/
        - .git/

{% endif %}
  # {{ '2' if has_db_module else '1' }}. Spring Boot application
  - name: {{ artifact_id }}-app
    type: java
    path: .
    parameters:
      buildpack: sap_java_buildpack_jakarta
      memory: 1G
      instances: 1
    build-parameters:
      builder: custom
      commands:
        - mvn package -DskipTests
      build-result: target/{{ artifact_id }}-1.0.0-SNAPSHOT.jar
    properties:
      JBP_CONFIG_OPEN_JDK_JRE: '{ jre: { version: {{ java_version }}.+ } }'
      SPRING_PROFILES_ACTIVE: cloud
    requires:
      - name: {{ hdi_service_name }}

# ── Resources ──────────────────────────────────────────────────────────────────

resources:
  - name: {{ hdi_service_name }}
    type: com.sap.xs.hdi-container
    parameters:
      service: hana
      service-plan: hdi-shared
